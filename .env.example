# =====================================================================
# EvidenceBot - Environment Variables Template
# =====================================================================

# 1. NCBI PubMed API Configuration
# Providing your email is recommended by NCBI to identify your app and prevent IP rate-limiting
NCBI_EMAIL=your_email@example.com

# Optional: If you register for an NCBI API key at https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# 2. LLM Provider Options (Choose ANY one or leave blank for Extractive Mode)

# Option A: Google Gemini API (Recommended - Free key at https://aistudio.google.com/)
GEMINI_API_KEY=

# Option B: OpenAI API (Alternative - https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Option C: Local Model via Ollama (100% offline, private inference)
USE_OLLAMA=false
OLLAMA_MODEL=llama3:latest
OLLAMA_BASE_URL=http://localhost:11434
